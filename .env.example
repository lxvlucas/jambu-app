# Exemplo: copie para .env.local se for usar scripts/iniciar-dev.ps1.
# O Spring e os scripts de teste não carregam dotenv automaticamente.
# Variáveis não vazias do processo vencem o arquivo; nunca versione .env.local.
JAMBU_DB_URL=jdbc:postgresql://127.0.0.1:5432/jambu
JAMBU_DB_USER=
JAMBU_DB_PASSWORD=
JAMBU_BIND_ADDRESS=127.0.0.1
# Obrigatória: segredo aleatório de 32 bytes em Base64, estável entre reinícios/instâncias.
# Gere com scripts/configurar-autenticacao.ps1; nunca use a chave pública dos testes.
JAMBU_AUTH_CHAVE_REPETICAO=
# Web desabilitada até informar origem exata. Produção exige HTTPS, sem barra final.
JAMBU_AUTH_ORIGEM_WEB=
JAMBU_AUTH_COOKIE_SEGURO=true
JAMBU_AUTH_DURACAO_ACESSO=PT15M
JAMBU_AUTH_INATIVIDADE=P30D
JAMBU_AUTH_LIMITE_ABSOLUTO=P180D
JAMBU_LIMITE_DISHES=20
JAMBU_LIMITE_REVIEW=2000
JAMBU_GOOGLE_PLACES_HABILITADO=false
JAMBU_GOOGLE_PLACES_API_KEY=
JAMBU_GOOGLE_PLACES_TIMEOUT=PT3S
JAMBU_GOOGLE_PLACES_LIMITE_DIA=100
JAMBU_REVISORES_RESTAURANTES=
# Áreas do catálogo (arquivos em src/main/resources/geografia), separadas por vírgula.
JAMBU_AREAS_CATALOGO=grande-sao-luis
# Lugares novos por pessoa por dia (fuso de São Luís); acima disso, 429 com Retry-After.
JAMBU_LIMITE_CADASTROS_DIA=5
# Somente endpoint oficial HTTPS ou simulador HTTP em 127.0.0.1, sempre /v1/.
JAMBU_GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1/
JAMBU_FOTOS_DIRETORIO_LOCAL=.local/storage-fotos
JAMBU_FOTOS_STORAGE_TIPO=local
JAMBU_FOTOS_SUPABASE_URL=
JAMBU_FOTOS_SUPABASE_KEY=
JAMBU_FOTOS_SUPABASE_BUCKET=jambu-fotos-privadas
JAMBU_FOTOS_MODERACAO_HABILITADA=false
JAMBU_FOTOS_MODERACAO_PROVEDOR=rekognition
JAMBU_FOTOS_MODERACAO_BASE_URL=https://rekognition.us-east-1.amazonaws.com/
JAMBU_FOTOS_MODERACAO_API_KEY=
JAMBU_FOTOS_MODERACAO_TIMEOUT=PT5S
JAMBU_MODERADORES_USERNAMES=
